{
  "manifest_version": 3,
  "name": "CvMax",
  "version": "0.1.35",
  "description": "Connect the active recruitment page to the local CvMax service for fill-and-verify tasks.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CvMax",
    "default_popup": "popup.html"
  }
}
