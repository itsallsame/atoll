{
  "manifest_version": 3,
  "name": "CvMax",
  "version": "0.2.45",
  "description": "Connect the active recruitment page to the local CvMax service for fill-and-verify tasks.",
  "permissions": ["storage", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CvMax",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["assets/cvmax-companion-cutout.png"],
    "matches": ["http://*/*", "https://*/*"]
  }]
}
