# CvMax public experience registry backend. Keep real values in .env.local.
CVMAX_DB_HOST=
CVMAX_DB_PORT=3306
CVMAX_DB_NAME=cvmax
CVMAX_DB_USER=cvmax_app
CVMAX_DB_PASSWORD=
CVMAX_DB_SSL=required

# Central registry process. Put it behind HTTPS in production.
CVMAX_REGISTRY_HOST=127.0.0.1
CVMAX_REGISTRY_PORT=8791
CVMAX_REGISTRY_WRITE_TOKEN=
CVMAX_REGISTRY_PRIVATE_KEY=
CVMAX_REGISTRY_PUBLIC_KEY=
CVMAX_REGISTRY_SIGNING_KEY_ID=
CVMAX_REGISTRY_INSTALLATION_PEPPER=
CVMAX_REGISTRY_CANARY_INSTALLATIONS=3
CVMAX_REGISTRY_RELEASE_INSTALLATIONS=5
CVMAX_REGISTRY_SUSPEND_FAILURES=2
CVMAX_REGISTRY_MAXIMUM_FAILURE_RATE=0.1
