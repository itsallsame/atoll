CVMAX_DB_HOST=mysql.example.internal
CVMAX_DB_PORT=3306
CVMAX_DB_NAME=cvmax
CVMAX_DB_USER=cvmax_app
CVMAX_DB_PASSWORD=replace-me
CVMAX_DB_SSL=required
CVMAX_REGISTRY_AUTH_MODE=installation
CVMAX_REGISTRY_ADMIN_TOKEN=replace-with-separate-random-admin-token
CVMAX_REGISTRY_TRUST_TLS_PROXY=true
CVMAX_REGISTRY_PRIVATE_KEY=replace-with-one-line-pem-using-backslash-n
CVMAX_REGISTRY_SIGNING_KEY_ID=production-key-id
CVMAX_REGISTRY_INSTALLATION_PEPPER=replace-with-random-pepper
CVMAX_REGISTRY_CANARY_INSTALLATIONS=3
CVMAX_REGISTRY_RELEASE_INSTALLATIONS=5
CVMAX_REGISTRY_SUSPEND_FAILURES=2
CVMAX_REGISTRY_MAXIMUM_FAILURE_RATE=0.1
