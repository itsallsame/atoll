FROM node:22-bookworm-slim

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY src ./src
COPY scripts ./scripts
COPY db ./db

ENV NODE_ENV=production \
    CVMAX_REGISTRY_HOST=0.0.0.0 \
    CVMAX_REGISTRY_PORT=8791
EXPOSE 8791
USER node
HEALTHCHECK --interval=15s --timeout=5s --retries=4 CMD node -e "fetch('http://127.0.0.1:8791/readyz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm","run","registry:start"]
